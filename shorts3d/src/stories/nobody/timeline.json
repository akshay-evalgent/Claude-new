{
 "durationMs": 31924,
 "lines": [
  {
   "id": "rule",
   "text": "In my town, you don't choose your name.",
   "startMs": 250,
   "endMs": 2076
  },
  {
   "id": "crowd",
   "text": "The crowd chooses it for you.",
   "startMs": 2234,
   "endMs": 3521
  },
  {
   "id": "stage",
   "text": "On your tenth birthday, you walk onto the stage,",
   "startMs": 3823,
   "endMs": 6267
  },
  {
   "id": "shout",
   "text": "and the whole town shouts one word.",
   "startMs": 6384,
   "endMs": 8061
  },
  {
   "id": "brave",
   "text": "My best friend got Brave.",
   "startMs": 8441,
   "endMs": 9778
  },
  {
   "id": "clever",
   "text": "My sister got Clever.",
   "startMs": 10034,
   "endMs": 11271
  },
  {
   "id": "turn",
   "text": "Then it was my turn.",
   "startMs": 11576,
   "endMs": 12544
  },
  {
   "id": "yell",
   "text": "Someone in the back yelled,",
   "startMs": 12912,
   "endMs": 14189
  },
  {
   "id": "nobody",
   "text": "Nobody!",
   "startMs": 14588,
   "endMs": 15156
  },
  {
   "id": "loved",
   "text": "And the crowd loved it.",
   "startMs": 15607,
   "endMs": 16604
  },
  {
   "id": "mayor",
   "text": "The mayor laughed so hard he cried.",
   "startMs": 16767,
   "endMs": 18762
  },
  {
   "id": "years",
   "text": "For years, I was Nobody.",
   "startMs": 19217,
   "endMs": 20803
  },
  {
   "id": "gold",
   "text": "Then one night, the mayor's gold disappeared.",
   "startMs": 21312,
   "endMs": 23637
  },
  {
   "id": "guards",
   "text": "The guards asked who went near the vault.",
   "startMs": 23956,
   "endMs": 25971
  },
  {
   "id": "answer",
   "text": "And the whole town gave the same answer.",
   "startMs": 26178,
   "endMs": 28093
  },
  {
   "id": "nobody2",
   "text": "Nobody.",
   "startMs": 28443,
   "endMs": 29012
  },
  {
   "id": "best",
   "text": "Best name I ever got.",
   "startMs": 29624,
   "endMs": 30921
  }
 ],
