# Copy this file to .env and fill it in. Then start Claude Code with:
#   PowerShell:  .\scripts\start-claude.ps1
# That script loads these variables, auto-detects Comet if COMET_PATH is empty,
# and runs `claude`. Claude Code expands ${VAR} references in .mcp.json from the
# environment it was started in.
#
# Use forward slashes in paths. Node and Playwright accept them on Windows and
# they avoid backslash-escaping problems.

# --- brave-search (Brave Search API, https://brave.com/search/api/) ---
# This is a search API only. It has nothing to do with which browser you use.
BRAVE_API_KEY=

# --- comet-browser (Playwright MCP, extension mode: your live Comet, logged in) ---
# Optional. Set to skip the per-connection approval popup in the Playwright Extension.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# --- comet-direct (Playwright MCP launching Comet itself with its own profile) ---
# Leave empty to auto-detect. Comet normally installs per-user at:
#   C:/Users/YOUR_NAME/AppData/Local/Perplexity/Comet/Application/comet.exe
# If detection fails, right-click your Comet shortcut > Properties > Target and paste it here.
COMET_PATH=

# Separate persistent profile for the automated browser (log in once, it sticks).
# Never point this at your real Comet profile folder.
COMET_MCP_PROFILE_DIR=./.comet-mcp-profile

# Where screenshots, PDFs and saved files land.
COMET_MCP_OUTPUT_DIR=./downloads
