# Copy to .env and fill in. Load it before starting Claude Code, e.g.:
#   set -a; source .env; set +a; claude
# Claude Code expands ${VAR} references in .mcp.json from the shell environment.

# --- brave-search (Brave Search API, https://brave.com/search/api/) ---
BRAVE_API_KEY=

# --- brave-browser (Playwright MCP, extension mode: your live Brave, logged in) ---
# Optional. Set to skip the per-connection approval popup in the Playwright Extension.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# --- brave-direct (Playwright MCP launching Brave itself with its own profile) ---
# Brave binary. Pick the line for your OS.
# macOS:   /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
# Linux:   /usr/bin/brave-browser
# Windows: C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
BRAVE_PATH=/usr/bin/brave-browser

# Separate persistent profile for the automated browser (log in once, it sticks).
BRAVE_MCP_PROFILE_DIR=./.brave-mcp-profile

# Where screenshots, PDFs and saved files land.
BRAVE_MCP_OUTPUT_DIR=./downloads
