# Copy this file to .env and fill it in. Then start Claude Code with:
#   PowerShell:  .\scripts\start-claude.ps1
# That script loads these variables and runs `claude`. Claude Code expands
# ${VAR} references in .mcp.json from the environment it was started in.
#
# Use forward slashes in paths. Node and Playwright accept them on Windows and
# they avoid backslash-escaping problems.

# --- brave-search (Brave Search API, https://brave.com/search/api/) ---
BRAVE_API_KEY=

# --- brave-browser (Playwright MCP, extension mode: your live Brave, logged in) ---
# Optional. Set to skip the per-connection approval popup in the Playwright Extension.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# --- brave-direct (Playwright MCP launching Brave itself with its own profile) ---
# Brave binary. The first line is the all-users install, the second the per-user install.
BRAVE_PATH=C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe
# BRAVE_PATH=C:/Users/YOUR_NAME/AppData/Local/BraveSoftware/Brave-Browser/Application/brave.exe

# Separate persistent profile for the automated browser (log in once, it sticks).
# Never point this at your real Brave profile folder.
BRAVE_MCP_PROFILE_DIR=./.brave-mcp-profile

# Where screenshots, PDFs and saved files land.
BRAVE_MCP_OUTPUT_DIR=./downloads
