# ---- LLM -------------------------------------------------------------------
# claude-code : use the Claude account already logged in to the `claude` CLI (default, no key)
# anthropic   : use ANTHROPIC_API_KEY through langchain-anthropic   (uv sync --extra anthropic)
# gemini      : use GOOGLE_API_KEY free tier through langchain-google-genai (uv sync --extra gemini)
# ollama      : local model through langchain-ollama                 (uv sync --extra ollama)
LLM_PROVIDER=claude-code
LLM_MODEL=claude-opus-5-5           # Analyst and Critic
LLM_MODEL_TRIAGE=claude-haiku-5-5   # Triage (claude-code and anthropic providers; others use LLM_MODEL)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_MODEL=llama3.1

# ---- Tracing (free LangSmith Developer plan) --------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=animation-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=animation-agent      # the Agent ID you chose in the LangSmith "Connect an agent" dialog
LANGSMITH_AGENT_ENVIRONMENT=development # local | development | staging | production: tags traces by where they ran

# ---- Optional free data keys (added in later milestones) --------------------
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TAVILY_API_KEY=
GITHUB_TOKEN=
YTDLP_JS_RUNTIME=node
