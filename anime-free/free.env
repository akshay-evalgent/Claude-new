# Environment for running the make-an-anime pipeline with the free backend on Linux. Usage: source free.env
export MV_BACKEND=free                       # route every Fal call to the free backend
export LC_ALL=C.UTF-8 LANG=C.UTF-8           # prompts and manifests contain non-ASCII text
export MEDIA_FONT=/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf   # labels on review boards
export CHROME_PATH=/usr/local/bin/chrome-for-p5   # headless Chromium wrapper that passes --no-sandbox
# KAGGLE_API_TOKEN must be set in the environment for the Kaggle batches.
