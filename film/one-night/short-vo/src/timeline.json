 "captions": [
  {
   "t0": 0.6,
   "t1": 2.15,
   "text": "Santa has one night",
   "who": "narrator"
  },
  {
   "t0": 2.15,
   "t1": 4.075,
   "text": "to deliver every present",
   "who": "narrator"
  },
  {
   "t0": 4.305,
   "t1": 5.93,
   "text": "Midnight to six",
   "who": "narrator"
  },
  {
   "t0": 7.76,
   "t1": 8.297,
   "text": "But what if he",
   "who": "narrator"
  },
  {
   "t0": 8.297,
   "t1": 9.61,
   "text": "flew so fast",
   "who": "narrator"
  },
  {
   "t0": 9.61,
   "t1": 11.11,
   "text": "that time itself began",
   "who": "narrator"
  },
  {
   "t0": 11.11,
   "t1": 12.035,
   "text": "to bend",
   "who": "narrator"
  },
  {
   "t0": 12.165,
   "t1": 13.165,
   "text": "Einstein showed",
   "who": "narrator"
  },
  {
   "t0": 13.165,
   "t1": 14.64,
   "text": "that the faster you move",
   "who": "narrator"
  },
  {
   "t0": 14.74,
   "t1": 16.665,
   "text": "the slower your clock ticks",
   "who": "narrator"
  },
  {
   "t0": 17.127,
   "t1": 18.277,
   "text": "Fly close enough to",
   "who": "narrator"
  },
  {
   "t0": 18.277,
   "t1": 19.577,
   "text": "the speed of light",
   "who": "narrator"
  },
  {
   "t0": 19.677,
   "t1": 20.327,
   "text": "and one night",
   "who": "narrator"
  },
  {
   "t0": 20.327,
   "t1": 21.04,
   "text": "for you can be",
   "who": "narrator"
  },
  {
   "t0": 21.04,
   "t1": 23.002,
   "text": "years for everyone else",
   "who": "narrator"
  },
  {
   "t0": 24.282,
   "t1": 24.882,
   "text": "At home",
   "who": "narrator"
  },
  {
   "t0": 24.969,
   "t1": 26.307,
   "text": "nobody is moving",
   "who": "narrator"
  },
  {
   "t0": 26.407,
   "t1": 28.332,
   "text": "Their clocks run normally",
   "who": "narrator"
  },
  {
   "t0": 28.812,
   "t1": 29.562,
   "text": "Every second",
   "who": "narrator"
  },
  {
   "t0": 29.562,
   "t1": 30.524,
   "text": "on his watch",
   "who": "narrator"
  },
  {
   "t0": 30.524,
   "t1": 32.437,
   "text": "is nine hours here",
   "who": "narrator"
  },
  {
   "t0": 33.667,
   "t1": 35.392,
   "text": "He spends three seconds",
   "who": "narrator"
  },
  {
   "t0": 35.392,
   "t1": 37.317,
   "text": "in a child's living room",
   "who": "narrator"
  },
  {
   "t0": 37.747,
   "t1": 38.547,
   "text": "Back home",
   "who": "narrator"
  },
  {
   "t0": 38.647,
   "t1": 39.372,
   "text": "more than a day",
   "who": "narrator"
  },
  {
   "t0": 39.372,
   "t1": 40.497,
   "text": "goes by",
   "who": "narrator"
  },
  {
   "t0": 41.277,
   "t1": 42.402,
   "text": "One year",
   "who": "narrator"
  },
  {
   "t0": 42.732,
   "t1": 43.482,
   "text": "Ten",
   "who": "narrator"
  },
  {
   "t0": 44.362,
   "t1": 45.262,
   "text": "Twenty-three",
   "who": "narrator"
  },
  {
   "t0": 48.892,
   "t1": 50.005,
   "text": "He lands at six",
   "who": "narrator"
  },
  {
   "t0": 50.005,
   "t1": 50.892,
   "text": "in the morning",
   "who": "narrator"
  },
  {
   "t0": 51.03,
   "t1": 52.417,
   "text": "Right on time",
   "who": "narrator"
  },
  {
   "t0": 53.397,
   "t1": 54.484,
   "text": "But the house has",
   "who": "narrator"
  },
  {
   "t0": 54.484,
   "t1": 57.034,
   "text": "waited through twenty-three Christmases",
   "who": "narrator"
  },
  {
   "t0": 59.252,
   "t1": 60.977,
   "text": "You were gone one night",
   "who": "her"
  },
  {
   "t0": 62.582,
   "t1": 63.232,
   "text": "For him",
   "who": "narrator"
  },
  {
   "t0": 63.344,
   "t1": 64.382,
   "text": "it was",
   "who": "narrator"
  }
 ]
}